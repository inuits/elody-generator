# The analytics terms (ea:): what an overlay says beyond the W3C Data Cube
# vocabulary (qb:) it builds on. An overlay selects the document paths of a
# client's entities that are analysed; it lives next to the client's UI
# declaration, outside ui/, and is read by `elody-ui analytics`.
# Kept here, not in elody-ontology, until analytics gets an ontology folder there.
@prefix ea:   <https://elody.eu/ns/analytics#> .
@prefix qb:   <http://purl.org/linked-data/cube#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

<https://elody.eu/ns/analytics> a owl:Ontology ;
  rdfs:label "Elody analytics" ;
  owl:versionInfo "0.1.0" ;
  rdfs:comment "Which document paths of a client's entities are analysed, and how they are read from the store." .

ea:sourceCollection a rdf:Property ;
  rdfs:domain qb:DataStructureDefinition ; rdfs:range xsd:string ;
  rdfs:comment "A Mongo collection the entities are read from." .

ea:documentSchema a rdf:Property ;
  rdfs:domain qb:DataStructureDefinition ; rdfs:range xsd:string ;
  rdfs:comment "Where the documents keep their values: \"v2\" at the path, \"v1\" with the audit at the top (date_created, created_by, date_updated, last_editor) and metadata and relations as lists matched on their key or type. The source paths stay logical (as the declaration's filter keys); v2 when absent." .

ea:entityTypes a rdf:Property ;
  rdfs:domain qb:DataStructureDefinition ; rdfs:range xsd:string ;
  rdfs:comment "An entity type (the document's `type`) the cube counts; the others are not read." .

ea:sourcePath a rdf:Property ;
  rdfs:range xsd:string ;
  rdfs:comment "The document path a dimension is read from, without the `<client>:<version>|` prefix of a filter key (`properties.material_type.value`)." .

ea:role a rdf:Property ;
  rdfs:range ea:Role ;
  rdfs:comment "What a dimension is to the cube beyond a plain dimension." .

ea:multiValued a rdf:Property ;
  rdfs:range xsd:boolean ;
  rdfs:comment "The path holds a list in a notable share of the documents: one row per value when it is counted." .

ea:via a rdf:Property ;
  rdfs:comment "The dimension's path holds identifiers of other entities (a relation): its values are those entities' labels. The node names the target's type(s) (ea:targetType) and where its label is (ea:labelPath)." .

ea:targetType a rdf:Property ;
  rdfs:range xsd:string ;
  rdfs:comment "An entity type a relation points at (the target document's `type`)." .

ea:labelPath a rdf:Property ;
  rdfs:range xsd:string ;
  rdfs:comment "The logical path of the label in the target document (`properties.title.value`)." .

ea:labelKey a rdf:Property ;
  rdfs:range xsd:string ;
  rdfs:comment "The translation key of the dimension's label, as the UI declaration names it (`metadata.labels.material-type`)." .

ea:Role a rdfs:Class ;
  rdfs:comment "A role of a dimension." .

ea:EntityType a ea:Role ;
  rdfs:comment "The dimension holding the entity's type; one per cube." .

ea:Time a ea:Role ;
  rdfs:comment "The dimension holding when the entity was created; one per cube." .

ea:entityCount a qb:MeasureProperty ;
  rdfs:label "Aantal entiteiten"@nl , "Number of entities"@en ;
  rdfs:comment "The number of entities." .

# --- the SLA: what a client's service level agreement promises, reported in
# Superset from the instance's ClickHouse (`elody-ui analytics sla`)

ea:ServiceLevelAgreement a rdfs:Class ;
  rdfs:label "Service level agreement" ;
  rdfs:comment "The goals and service credits of a client's SLA: availability from a check of the health endpoint, performance as the Apdex of the API's requests." .

ea:language a rdf:Property ;
  rdfs:comment "The language of the dashboard's titles and texts: \"nl\" or \"en\"." .

ea:retentionDays a rdf:Property ;
  rdfs:comment "How many days the measurements are kept (HyperDX keeps its spans 30 days; the SLA is measured per month and per year)." .

ea:availability a rdf:Property ;
  rdfs:comment "The availability goal: the share of the checks of the health endpoint that answered 200 within 10 seconds, per month." .

ea:performance a rdf:Property ;
  rdfs:comment "The performance goal: the Apdex of one service's server spans, per month." .

ea:goal a rdf:Property ;
  rdfs:comment "The value a month must reach (a share between 0 and 1); below it the credit tiers apply." .

ea:creditTier a rdf:Property ;
  rdfs:comment "A service credit below the goal: from ea:atLeast up, ea:creditPercent of the monthly fee; the one without ea:atLeast is the floor." .

ea:atLeast a rdf:Property ;
  rdfs:comment "The lowest value (a share between 0 and 1) of a credit tier." .

ea:creditPercent a rdf:Property ;
  rdfs:comment "The service credit of a tier, in percent of the monthly fee." .

ea:service a rdf:Property ;
  rdfs:comment "The OpenTelemetry service name whose server spans are measured (ServiceName in HyperDX)." .

ea:spanName a rdf:Property ;
  rdfs:comment "The name of the measured server spans, e.g. \"POST /api/graphql\"." .

ea:apdexThresholdMs a rdf:Property ;
  rdfs:comment "Apdex's T in milliseconds: satisfied up to T, tolerating up to 4 T, frustrated above." .

# --- dashboards: charts over named datasets and the metrics they carry
# (`elody-ui analytics bundle`). A dataset comes from a layer under the
# dashboard: the SLA (uptime, requests) or the overlay (its mart views).

ea:Dashboard a rdfs:Class ;
  rdfs:comment "A Superset dashboard: rdfs:label is its title, ea:items its charts and texts in order, laid out in rows of 12 columns." .

ea:Chart a rdfs:Class ;
  rdfs:comment "An item that draws a dataset: rdfs:label is its title, ea:dataset the dataset's name." .
ea:BigNumber a rdfs:Class ; rdfs:subClassOf ea:Chart ; rdfs:comment "One number: ea:measure over ea:period." .
ea:Table a rdfs:Class ; rdfs:subClassOf ea:Chart ; rdfs:comment "Rows per ea:groupBy with ea:measures, sorted by ea:sortBy." .
ea:Rows a rdfs:Class ; rdfs:subClassOf ea:Chart ; rdfs:comment "The dataset's rows as they are: their ea:columns, sorted by ea:sortBy; a column that holds a link is shown as one." .
ea:TimeSeries a rdfs:Class ; rdfs:subClassOf ea:Chart ; rdfs:comment "ea:measures over the dataset's time column per ea:timeGrain, as ea:style." .
ea:Ranking a rdfs:Class ; rdfs:subClassOf ea:Chart ; rdfs:comment "The top ea:limit values of ea:dimension by ea:measure, as horizontal bars." .
ea:Markdown a rdfs:Class ; rdfs:comment "A text (ea:text, Markdown) between the charts." .

ea:slug a rdf:Property ; rdfs:comment "The dashboard's address: /superset/dashboard/<slug>/." .
ea:items a rdf:Property ; rdfs:comment "The dashboard's charts and texts, an RDF list in reading order." .
ea:key a rdf:Property ; rdfs:comment "An item's stable name (its file and uuid); by default the title, as a slug." .
ea:dataset a rdf:Property ; rdfs:comment "The name of the dataset a chart draws." .
ea:measure a rdf:Property ; rdfs:comment "The one measure of a big number or a ranking." .
ea:measures a rdf:Property ; rdfs:comment "A list of measures: a dataset metric's name, or [ rdfs:label ; ea:sql ] inline." .
ea:groupBy a rdf:Property ; rdfs:comment "A table's rows: a list of column names, or [ rdfs:label ; ea:sql ] expressions." .
ea:columns a rdf:Property ; rdfs:comment "The columns ea:Rows shows: a list of the dataset's column names, in order." .
ea:dimension a rdf:Property ; rdfs:comment "The column a ranking counts by." .
ea:period a rdf:Property ; rdfs:comment "The time the chart covers: ea:CurrentMonth, ea:Last90Days or ea:AllTime (the default)." .
ea:CurrentMonth a rdfs:Resource . ea:Last90Days a rdfs:Resource . ea:AllTime a rdfs:Resource .
ea:timeGrain a rdf:Property ; rdfs:comment "A time series' step, as an ISO 8601 duration: P1D, P1W, P1M, P1Y." .
ea:style a rdf:Property ; rdfs:comment "A time series drawn as ea:Line, ea:Bar or ea:StackedBar." .
ea:Line a rdfs:Resource . ea:Bar a rdfs:Resource . ea:StackedBar a rdfs:Resource .
ea:subheader a rdf:Property ; rdfs:comment "The line under a big number." .
ea:format a rdf:Property ; rdfs:comment "A d3 number format, e.g. \",d\" or \",.3f\"." .
ea:sortBy a rdf:Property ; rdfs:comment "The measure or group label a table is sorted by; ea:ascending true sorts up." .
ea:ascending a rdf:Property .
ea:limit a rdf:Property ; rdfs:comment "The most rows a table or ranking shows." .
ea:search a rdf:Property ; rdfs:comment "A table with a search box." .
ea:width a rdf:Property ; rdfs:comment "An item's width, out of the row's 12 columns." .
ea:height a rdf:Property ; rdfs:comment "An item's height, in Superset's grid units (8 px)." .
ea:text a rdf:Property ; rdfs:comment "A Markdown item's text." .
ea:sql a rdf:Property ; rdfs:comment "A ClickHouse SQL expression." .

# --- the session overview: one row per browser tab, from HyperDX's spans and
# OpenPanel's events, joined on the session id the PWA gives both

ea:SessionOverview a rdfs:Class ;
  rdfs:label "Session overview" ;
  rdfs:comment "A layer under a dashboard: the dataset sessions, one row per browser tab with what it did (ea:counts), what went wrong, and a link to its replay in HyperDX and its events in OpenPanel." .

ea:userGroup a rdf:Property ;
  rdfs:comment "The group a user belongs to, from the client's data model: [ rdfs:label (the column's title) ; ea:users ; ea:membership ; ea:groups ; ea:groupName ]. The overview links a session's user (a pseudonym of their id) to it when it is read. Without it the overview has no such column." .
ea:users a rdf:Property ; rdfs:comment "The collection of the client's users." .
ea:membership a rdf:Property ; rdfs:comment "The user's property that holds the ids of the groups they belong to." .
ea:groups a rdf:Property ; rdfs:comment "The collection of the groups." .
ea:groupName a rdf:Property ; rdfs:comment "The group's property that is its name." .
ea:browserService a rdf:Property ;
  rdfs:comment "The OpenTelemetry service name of the client's browser application, whose spans carry the tab's session id." .
ea:browserError a rdf:Property ;
  rdfs:comment "A span name of the browser's that counts as an error, e.g. \"console.error\"." .
ea:counts a rdf:Property ;
  rdfs:comment "What the overview counts per session, an RDF list in column order: each [ ea:key ; rdfs:label ; ea:event and/or ea:property with ea:value ]." .
ea:event a rdf:Property ;
  rdfs:comment "An OpenPanel event name a count counts; several are counted together." .
ea:property a rdf:Property ;
  rdfs:comment "An OpenPanel event property a count looks at; it counts the events where it is ea:value." .
ea:value a rdf:Property ;
  rdfs:comment "The value of ea:property a count counts." .
