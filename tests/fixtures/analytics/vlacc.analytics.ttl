@prefix qb:    <http://purl.org/linked-data/cube#> .
@prefix ea:    <https://elody.eu/ns/analytics#> .
@prefix em:    <https://elody.io/ns/metadata#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vlacc: <https://elody.eu/analytics/vlacc#> .

# The analytics selection of vlacc: which document paths are analysed, as a W3C Data Cube structure.
# Generated by `elody-ui analytics overlay` from inventory/candidates.json; edit it by hand from here on.
# A dimension is switched off by commenting its qb:component line, switched on by uncommenting one under
# "left out". Exactly one component has ea:role ea:Time and one ea:role ea:EntityType;
# `elody-ui analytics validate <this file>` checks that.

vlacc:EntityActivity a qb:DataStructureDefinition ;
  rdfs:label "Aangemaakte entiteiten"@nl ;
  ea:sourceCollection "bibliographic_entities_actual" , "entities_actual" ;
  ea:entityTypes
    "award" , "code_wording" , "corporation" , "easy_reading" , "genre" , "language" ,
    "listening" , "manifestation_computer_file" , "manifestation_footage" , "manifestation_map" , "manifestation_mixed_material" , "manifestation_music" ,
    "manifestation_serial" , "manifestation_word" , "nomen" , "orienting" , "person" , "place" ,
    "playing" , "publisher" , "reading" , "siso" , "target_audience" , "time" ,
    "title" , "watching" , "work_computer_file" , "work_footage" , "work_map" , "work_mixed_material" ,
    "work_music" , "work_serial" , "work_word" , "zizo" ;

  # Type — SelectionFilter, TypeFilter, 129 filter(s) on Award, Boekenbank, Cantook, CodeWording, …
  qb:component [ qb:dimension em:type ; ea:sourcePath "type" ; ea:role ea:EntityType ; ea:labelKey "metadata.labels.type" ; rdfs:label "Type"@nl ] ;
  # Aangemaakt op — DateFilter, 1 filter(s) on fragment:entityAuditFilters
  qb:component [ qb:dimension em:created_at ; ea:sourcePath "audit.created.at" ; ea:role ea:Time ; ea:labelKey "metadata.labels.created-at" ; rdfs:label "Aangemaakt op"@nl ] ;
  # Aangemaakt door — SelectionFilter, 1 filter(s) on fragment:entityAuditFilters
  qb:component [ qb:dimension em:created_by ; ea:sourcePath "audit.created.by" ; ea:labelKey "metadata.labels.created-by" ; rdfs:label "Aangemaakt door"@nl ] ;
  # Taal — SelectionFilter, 1 filter(s) on Cantook
  # dropped by the profile: filled in no type's sample
#   qb:component [ qb:dimension em:language ; ea:sourcePath "language" ; ea:labelKey "metadata.labels.language" ; rdfs:label "Taal"@nl ] ;
  # Doelgroep — SelectionFilter, 5 filter(s) on Genre, Nomen, WorkComputerFile, WorkFootage, …
  qb:component [ qb:dimension em:audience_type ; ea:sourcePath "properties.audience_type.value" ; ea:labelKey "metadata.labels.target-audience" ; rdfs:label "Doelgroep"@nl ] ;
  # AVI leesniveau code — SelectionFilter, 1 filter(s) on Expression
  qb:component [ qb:dimension em:avi_read_level_code ; ea:sourcePath "properties.avi_read_level_code.value" ; ea:labelKey "metadata.labels.avi-read-level-code" ; rdfs:label "AVI leesniveau code"@nl ; ea:multiValued true ] ;
  # Bibliografisch type — SelectionFilter, 6 filter(s) on Boekenbank, Cantook, Comment, Manifestation, …
  qb:component [ qb:dimension em:bibliographic_type ; ea:sourcePath "properties.bibliographic_type.value" ; ea:labelKey "metadata.labels.bibliographic-type" ; rdfs:label "Bibliografisch type"@nl ] ;
  # Categorie — SelectionFilter, 2 filter(s) on Comment
  # dropped by the profile: filled in no type's sample
#   qb:component [ qb:dimension em:category ; ea:sourcePath "properties.category.value" ; ea:labelKey "element-labels.comment-category" ; rdfs:label "Categorie"@nl ] ;
  # Type — SelectionFilter, TextFilter, 3 filter(s) on Genre, WorkComputerFile, WorkFootage, WorkMap, …
  qb:component [ qb:dimension em:genre_type ; ea:sourcePath "properties.genre_type.value" ; ea:labelKey "metadata.labels.type" ; rdfs:label "Type"@nl ; ea:multiValued true ] ;
  # Bron online collectie — SelectionFilter, 2 filter(s) on Manifestation, app
  qb:component [ qb:dimension em:source_id_online_collection ; ea:sourcePath "properties.id_online_collection_group.value.source_id_online_collection" ; ea:labelKey "metadata.labels.source-online-collection" ; rdfs:label "Bron online collectie"@nl ; ea:multiValued true ] ;
  # Land- of taalaanduiding — SelectionFilter, 1 filter(s) on Siso
  qb:component [ qb:dimension em:land_or_language ; ea:sourcePath "properties.land_or_language.value" ; ea:labelKey "metadata.labels.land-language" ; rdfs:label "Land- of taalaanduiding"@nl ] ;
  # Niveau — SelectionFilter, TextFilter, 9 filter(s) on WorkComputerFile, WorkFootage, WorkMap, WorkMixedMaterial, …
  qb:component [ qb:dimension em:level ; ea:sourcePath "properties.level.value" ; ea:labelKey "metadata.labels.level" ; rdfs:label "Niveau"@nl ] ;
  # Leefdata — SelectionFilter, 4 filter(s) on Corporation, Expression, Genre, Listening, …
  qb:component [ qb:dimension em:life_dates ; ea:sourcePath "properties.life_dates.value" ; ea:labelKey "metadata.labels.life-dates" ; rdfs:label "Leefdata"@nl ] ;
  # Literair type — SelectionFilter, 7 filter(s) on Boekenbank, Cantook, Comment, Manifestation, …
  qb:component [ qb:dimension em:literary_type ; ea:sourcePath "properties.literary_type.value" ; ea:labelKey "metadata.labels.literary-type" ; rdfs:label "Literair type"@nl ] ;
  # Materiaaltype — SelectionFilter, 6 filter(s) on Boekenbank, Cantook, Comment, Manifestation, …
  qb:component [ qb:dimension em:material_type ; ea:sourcePath "properties.material_type.value" ; ea:labelKey "metadata.labels.material-type" ; rdfs:label "Materiaaltype"@nl ] ;
  # Jaar van uitgave — SelectionFilter, 6 filter(s) on Boekenbank, Cantook, Comment, Manifestation, …
  qb:component [ qb:dimension em:publication_year ; ea:sourcePath "properties.publication_year.value" ; ea:labelKey "metadata.labels.publication-year" ; rdfs:label "Jaar van uitgave"@nl ] ;
  # Recordformaat — SelectionFilter, 4 filter(s) on Boekenbank, Cantook, Comment, Manifestation, …
  qb:component [ qb:dimension em:record_format ; ea:sourcePath "properties.record_format.value" ; ea:labelKey "metadata.labels.record-format" ; rdfs:label "Recordformaat"@nl ] ;
  # Record type — SelectionFilter, 4 filter(s) on Boekenbank, Cantook, Comment, Expression, …
  qb:component [ qb:dimension em:record_type ; ea:sourcePath "properties.record_type.value" ; ea:labelKey "metadata.labels.record-type" ; rdfs:label "Record type"@nl ] ;
  # Rol — SelectionFilter, 1 filter(s) on Token
  # dropped by the profile: filled in no type's sample
#   qb:component [ qb:dimension em:roles ; ea:sourcePath "properties.roles.value" ; ea:labelKey "metadata.labels.token-roles" ; rdfs:label "Rol"@nl ] ;
  # Status — SelectionFilter, 2 filter(s) on Manifestation, app
  qb:component [ qb:dimension em:status_field ; ea:sourcePath "properties.status_field.value" ; ea:labelKey "metadata.labels.status" ; rdfs:label "Status"@nl ] ;
  # Status — SelectionFilter, 3 filter(s) on Comment, Token
  # dropped by the profile: filled in no type's sample
#   qb:component [ qb:dimension em:status ; ea:sourcePath "properties.status.value" ; ea:labelKey "metadata.labels.status" ; rdfs:label "Status"@nl ] ;
  # Doelgroep — SelectionFilter, TextFilter, 9 filter(s) on WorkComputerFile, WorkFootage, WorkMap, WorkMixedMaterial, …
  qb:component [ qb:dimension em:target_audience ; ea:sourcePath "properties.target_audience.value" ; ea:labelKey "metadata.labels.target-audience" ; rdfs:label "Doelgroep"@nl ] ;
  # Getagde groepen — SelectionFilter, 2 filter(s) on Comment
  # dropped by the profile: filled in no type's sample
#   qb:component [ qb:dimension em:thread_tagged_groups ; ea:sourcePath "properties.thread_tagged_groups.value" ; ea:labelKey "element-labels.comment-tagged-groups" ; rdfs:label "Getagde groepen"@nl ] ;
