  # dropped by the profile: filled in no type's sample
#   qb:component [ qb:dimension em:thread_tagged_users ; ea:sourcePath "properties.thread_tagged_users.value" ; ea:labelKey "element-labels.comment-tagged-users" ; rdfs:label "Getagde gebruikers"@nl ] ;
